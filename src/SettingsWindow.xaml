<Window x:Class="PersiaPad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات PersiaPad" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="تنظیمات ظاهری" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource ChromeForegroundBrush}" Margin="0,0,0,12"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="تم" Margin="0,8,0,4" Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <ComboBox x:Name="ThemeCombo" Height="30"/>

            <TextBlock Text="فونت" Margin="0,12,0,4" Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <ComboBox x:Name="FontCombo" Height="30" IsEditable="True"/>

            <TextBlock Text="اندازه فونت" Margin="0,12,0,4" Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SizeSlider" Minimum="6" Maximum="48" Width="320"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="SizeLabel" Width="40" TextAlignment="Center"
                           Foreground="{DynamicResource ChromeForegroundBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="رنگ متن (اختیاری، خالی = رنگ تم)" Margin="0,12,0,4"
                       Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ColorBox" Width="200" Height="30" VerticalContentAlignment="Center"/>
                <Border x:Name="ColorPreview" Width="30" Height="30" Margin="8,0"
                        BorderBrush="Gray" BorderThickness="1"/>
                <Button Content="پاک کردن" Width="80" Height="30" Click="ClearColor_Click"/>
            </StackPanel>

            <CheckBox x:Name="WordWrapCheck" Content="شکستن خطوط" Margin="0,16,0,0"
                      Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <CheckBox x:Name="LineNumbersCheck" Content="نمایش شماره خطوط" Margin="0,8,0,0"
                      Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <CheckBox x:Name="HighlightLineCheck" Content="هایلایت خط فعلی" Margin="0,8,0,0"
                      Foreground="{DynamicResource ChromeForegroundBrush}"/>
            <CheckBox x:Name="RestoreSessionCheck" Content="بازیابی تب‌ها هنگام اجرا" Margin="0,8,0,0"
                      Foreground="{DynamicResource ChromeForegroundBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="ذخیره" Width="100" Height="34" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="انصراف" Width="100" Height="34" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
