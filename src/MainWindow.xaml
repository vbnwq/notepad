<Window x:Class="PersiaPad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PersiaPad" Height="680" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Sensible defaults so the designer/first paint never crash before
             ThemeManager.Apply runs. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#252526"/>
        <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="LineNumberBrush" Color="#858585"/>
        <SolidColorBrush x:Key="CurrentLineBrush" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#264F78"/>
        <SolidColorBrush x:Key="CaretBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabActiveBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TabInactiveBrush" Color="#2D2D2D"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{x:Static ApplicationCommands.New}"/>
        <KeyBinding Modifiers="Control" Key="O" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{x:Static ApplicationCommands.SaveAs}"/>
        <KeyBinding Modifiers="Control" Key="W" Command="{x:Static ApplicationCommands.Close}"/>
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static ApplicationCommands.Find}"/>
        <KeyBinding Modifiers="Control" Key="H" Command="{x:Static ApplicationCommands.Replace}"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ===== Menu bar ===== -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu"
              Background="{DynamicResource ChromeBackgroundBrush}"
              Foreground="{DynamicResource ChromeForegroundBrush}">
            <MenuItem Header="فایل">
                <MenuItem Header="جدید" InputGestureText="Ctrl+N" Click="New_Click"/>
                <MenuItem Header="باز کردن..." InputGestureText="Ctrl+O" Click="Open_Click"/>
                <Separator/>
                <MenuItem Header="ذخیره" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="ذخیره به‌نام..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="بستن تب" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <MenuItem Header="خروج" Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="ویرایش">
                <MenuItem Header="واگرد" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="ازنو" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="برش" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="کپی" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="چسباندن" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="تکرار خط (Duplicate)" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
                <MenuItem Header="انتخاب همه" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <Separator/>
                <MenuItem Header="یافتن..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="جایگزینی..." InputGestureText="Ctrl+H" Click="Replace_Click"/>
            </MenuItem>

            <MenuItem Header="نما">
                <MenuItem x:Name="WordWrapMenu" Header="شکستن خطوط (Word Wrap)" IsCheckable="True" Click="WordWrap_Click"/>
                <MenuItem x:Name="LineNumbersMenu" Header="شماره خطوط" IsCheckable="True" Click="LineNumbers_Click"/>
                <Separator/>
                <MenuItem x:Name="RtlMenu" Header="جهت راست‌به‌چپ (فارسی)" IsCheckable="True" Click="Rtl_Click"/>
                <Separator/>
                <MenuItem Header="بزرگ‌نمایی فونت" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="کوچک‌نمایی فونت" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
            </MenuItem>

            <MenuItem Header="تم" x:Name="ThemeMenu"/>

            <MenuItem Header="ابزار">
                <MenuItem Header="تنظیمات..." Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="تنظیم به عنوان برنامه پیش‌فرض متن ویندوز" Click="SetDefault_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentBrush}" Height="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessage" Grid.Column="0" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0" Text="آماده"/>
                <TextBlock x:Name="StatusCaret" Grid.Column="1" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0" Text="خط 1، ستون 1"/>
                <TextBlock x:Name="StatusLength" Grid.Column="2" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0" Text="0 نویسه"/>
                <TextBlock x:Name="StatusEncoding" Grid.Column="3" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0" Text="UTF-8"/>
                <Border Grid.Column="4" Background="#33FFFFFF" Margin="4,3" CornerRadius="3">
                    <TextBlock x:Name="StatusLanguage" Foreground="White"
                               VerticalAlignment="Center" Margin="8,0" Text="text"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Tabs ===== -->
        <TabControl x:Name="Tabs" DockPanel.Dock="Top"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderThickness="0"
                    SelectionChanged="Tabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{DynamicResource TabInactiveBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>
        </TabControl>

    </DockPanel>
</Window>
